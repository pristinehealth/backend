NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:19006

SESSION_SECRET=change_me_to_a_long_random_value

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=

# Your backend public URL, used to build redirect URI and issuer checks
PUBLIC_BASE_URL=http://localhost:8080

# The redirect URI registered in Google Cloud Console:
# e.g. http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_PATH=/auth/google/callback
